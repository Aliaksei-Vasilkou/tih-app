{
  "number_of_shards": "1",
  "number_of_replicas": "0",
  "max_ngram_diff": "8",
  "analysis": {
    "analyzer": {
      "english_standard": {
        "tokenizer": "standard",
        "filter": ["lowercase", "english_stop", "english_stemmer"]
      },
      "ngram_analyzer": {
        "tokenizer": "standard",
        "filter": ["lowercase", "ngram_filter"]
      },
      "english_lowercase": {
        "tokenizer": "standard",
        "filter": ["lowercase"]
      }
    },
    "filter": {
      "english_stop": {
        "type": "stop",
        "stopwords": "_english_"
      },
      "english_stemmer": {
        "type": "stemmer",
        "language": "english"
      },
      "ngram_filter": {
        "type": "ngram",
        "min_gram": "2",
        "max_gram": "10"
      }
    }
  }
}
