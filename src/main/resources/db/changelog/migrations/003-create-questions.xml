<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-questions" author="tih">
        <createTable tableName="questions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="question_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="answer_content" type="TEXT"/>
            <column name="language_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_questions_language"
                             references="languages(id)"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_questions_category"
                             references="categories(id)"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="search_vector" type="TSVECTOR"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="last_modified_by" type="VARCHAR(100)"/>
        </createTable>

        <createIndex tableName="questions" indexName="idx_questions_language_id">
            <column name="language_id"/>
        </createIndex>
        <createIndex tableName="questions" indexName="idx_questions_category_id">
            <column name="category_id"/>
        </createIndex>
        <createIndex tableName="questions" indexName="idx_questions_active">
            <column name="active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
