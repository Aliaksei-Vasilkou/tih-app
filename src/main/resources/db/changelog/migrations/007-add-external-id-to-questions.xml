<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-add-external-id-to-questions" author="tih">

        <!-- 1. Add column as nullable first so existing rows don't violate the constraint -->
        <addColumn tableName="questions">
            <column name="external_id" type="UUID"/>
        </addColumn>

        <!-- 2. Backfill all existing rows with a fresh UUID -->
        <sql>UPDATE questions SET external_id = gen_random_uuid() WHERE external_id IS NULL</sql>

        <!-- 3. Enforce NOT NULL and UNIQUE -->
        <addNotNullConstraint tableName="questions" columnName="external_id" columnDataType="UUID"/>
        <addUniqueConstraint tableName="questions" columnNames="external_id"
                             constraintName="uq_questions_external_id"/>

        <!-- 4. Index for fast lookup during import deduplication -->
        <createIndex tableName="questions" indexName="idx_questions_external_id" unique="true">
            <column name="external_id"/>
        </createIndex>

        <!-- 5. Audit table: nullable column only (Envers requirement) -->
        <addColumn tableName="questions_aud">
            <column name="external_id" type="UUID"/>
        </addColumn>

    </changeSet>

</databaseChangeLog>
