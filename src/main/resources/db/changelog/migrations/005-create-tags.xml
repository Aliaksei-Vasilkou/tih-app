<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-tags" author="tih">
        <createTable tableName="tags">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="language_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_tags_language"
                             references="languages(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="last_modified_by" type="VARCHAR(100)"/>
        </createTable>

        <addUniqueConstraint tableName="tags"
                             columnNames="name, language_id"
                             constraintName="uq_tags_name_language"/>

        <createIndex tableName="tags" indexName="idx_tags_language_id">
            <column name="language_id"/>
        </createIndex>

        <createTable tableName="question_tags">
            <column name="question_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_question_tags_question"
                             references="questions(id)"
                             deleteCascade="true"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_question_tags_tag"
                             references="tags(id)"
                             deleteCascade="true"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="question_tags"
                       columnNames="question_id, tag_id"
                       constraintName="pk_question_tags"/>

        <createIndex tableName="question_tags" indexName="idx_question_tags_question_id">
            <column name="question_id"/>
        </createIndex>
        <createIndex tableName="question_tags" indexName="idx_question_tags_tag_id">
            <column name="tag_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
